 143:Core/Src/ST7735.c **** void ST7735_Init(void) {
 144:Core/Src/ST7735.c ****     // Hardware reset
 145:Core/Src/ST7735.c ****     RST_LOW(); HAL_Delay(10);
 146:Core/Src/ST7735.c ****     RST_HIGH(); HAL_Delay(120);
 147:Core/Src/ST7735.c **** 
